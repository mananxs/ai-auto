# ---------- Database (Neon Postgres) ----------
# DATABASE_URL = POOLED host (contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL = DIRECT host (no "-pooler"). Used by `prisma migrate` only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ---------- Secrets ----------
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Used ONLY by `npx prisma db seed` to store an encrypted token for the dev recruiter.
# Classic GitHub PAT with NO scopes ticked is enough (public data only).
GITHUB_PAT=""

# ---------- Behaviour ----------
LLM_MODEL="gemini-2.5-flash"
EVAL_CONCURRENCY=2
# Local dev only: skips login and uses the seeded recruiter. Never true in production.
DEV_AUTH=true
DEV_RECRUITER_EMAIL="recruiter@talentgraph.dev"
LOG_LEVEL="info"

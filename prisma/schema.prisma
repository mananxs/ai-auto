// TalentGraph data model.
// Conventions:
//  - Tables are snake_case plural (@@map), columns stay camelCase.
//    In raw SQL always quote column names: m."jobId", c."githubId".
//  - Every id is a UUID generated by the DATABASE (gen_random_uuid()),
//    so raw INSERT ... ON CONFLICT statements work without Prisma.
//  - updatedAt has a DB default too, so raw SQL must still set updatedAt = now() on UPDATE.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Runtime connection: Neon POOLED host (-pooler).
  url        = env("DATABASE_URL")
  // Migrations connection: Neon DIRECT host.
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum BatchStatus {
  queued
  running
  completed
  failed
}

enum MatchStatus {
  pending
  completed
  failed
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  recruiters Recruiter[]
  jobs       JobDescription[]

  @@index([createdAt])
  @@index([updatedAt])
  @@map("organizations")
}

model Recruiter {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  email          String   @unique
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthTokens      OAuthToken[]
  jobs             JobDescription[]
  ingestionBatches IngestionBatch[]

  @@index([organizationId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("recruiters")
}

/// Third-party tokens (e.g. the recruiter's GitHub token).
/// encryptedToken format: "v1:<iv>:<authTag>:<ciphertext>" (AES-256-GCM, base64 parts).
model OAuthToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recruiterId    String    @db.Uuid
  provider       String
  encryptedToken String    @db.Text
  scopes         String[]  @default([])
  expiresAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  recruiter Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, provider])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("oauth_tokens")
}

model JobDescription {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @db.Uuid
  createdById     String   @db.Uuid
  title           String
  description     String   @db.Text
  requiredSkills  String[] @default([])
  preferredSkills String[] @default([])
  /// Programming languages used for the GitHub search (e.g. ["Python"]).
  languages       String[] @default([])
  /// One GitHub search is run per location (qualifiers are ANDed by GitHub).
  locations       String[] @default([])
  remoteAllowed   Boolean  @default(false)
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Recruiter       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  batches      IngestionBatch[]
  matchScores  MatchScore[]

  @@index([organizationId, createdAt])
  @@index([createdById])
  @@index([updatedAt])
  @@map("job_descriptions")
}

model Candidate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  githubId         BigInt   @unique
  login            String
  name             String?
  avatarUrl        String?
  profileUrl       String
  bio              String?  @db.Text
  location         String?
  githubCreatedAt  DateTime? @db.Timestamptz(3)
  yearsActive      Float?
  /// Shares by bytes, e.g. { "Python": 0.62, "TypeScript": 0.21 }
  topLanguages     Json     @default("{}")
  topics           String[] @default([])
  /// Stays null until enrichment (Phase 6). We never request the GitHub `email` field.
  publicEmail      String?
  profileText      String?  @db.Text
  embedding        Unsupported("vector(1536)")?
  lastIngestedAt   DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  matchScores MatchScore[]

  @@index([login])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("candidates")
}

model IngestionBatch {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId              String      @db.Uuid
  requestedById      String      @db.Uuid
  status             BatchStatus @default(queued)
  maxProfiles        Int         @default(100)
  profilesFound      Int         @default(0)
  candidatesUpserted Int         @default(0)
  embeddedCount      Int         @default(0)
  evaluatedCount     Int         @default(0)
  failedCount        Int         @default(0)
  error              String?     @db.Text
  startedAt          DateTime?   @db.Timestamptz(3)
  finishedAt         DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  job         JobDescription @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy Recruiter      @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  matchScores MatchScore[]

  // The worker polls: WHERE status = 'queued' ORDER BY createdAt
  @@index([status, createdAt])
  @@index([jobId, createdAt])
  @@index([requestedById])
  @@index([updatedAt])
  @@map("ingestion_batches")
}

model MatchScore {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String      @db.Uuid
  candidateId   String      @db.Uuid
  batchId       String?     @db.Uuid
  /// 0-100. Null while pending/failed. Range enforced by a CHECK constraint (see migration).
  score         Int?
  matchedSkills String[]    @default([])
  missingSkills String[]    @default([])
  status        MatchStatus @default(pending)
  model         String?
  error         String?     @db.Text
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  job       JobDescription  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  batch     IngestionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([jobId, candidateId])
  @@index([jobId, score(sort: Desc)])
  @@index([candidateId])
  @@index([batchId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("match_scores")
}
